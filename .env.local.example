# Convex deployment URL (set by `npx convex dev`)
VITE_CONVEX_URL=

# Kavenegar SMS (Convex dashboard env vars for backend)
# KAVENEGAR_TOKEN=your-kavenegar-api-key
# KAVENEGAR_TEMPLATE=moonshot-verify
# Optional proxy prefix for Kavenegar API:
# KAVENEGAR_PROXY_URL=https://your-proxy.example/https://api.kavenegar.com/v1