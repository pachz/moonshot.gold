# Convex deployment URL (set by `npx convex dev`)
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Vercel (optional, for auto-deploying Convex on each push):
# CONVEX_DEPLOY_KEY=... from Convex Dashboard → Settings → Deploy Key
# Then set Vercel Build Command to: npx convex deploy --cmd 'npm run build:frontend'
# Commit convex/_generated/ so `npm run build` works without the deploy key.

# Convex Auth keys (set on deployment via `node setupAuthKeys.mjs` or `npx @convex-dev/auth`)
# SITE_URL=http://localhost:5173
# JWT_PRIVATE_KEY=...
# JWKS=...

# Kavenegar SMS (set on Convex deployment — Dashboard → Settings → Environment Variables)
# KAVENEGAR_TOKEN=your-kavenegar-api-key
# KAVENEGAR_TEMPLATE=moonshot-verify
# KAVENEGAR_PROXY_URL=https://your-proxy.example

# Zohal Shahkar identity verification (set on Convex deployment)
# ZOHAL_API_TOKEN=your-zohal-api-token
# SHAHKAR_API_URL=https://service.zohal.io/api/v0/services/inquiry/shahkar
# OUTBOUND_PROXY_URL=https://your-proxy.example

# Zibal payment gateway (set on Convex deployment)
# ZIBAL_MERCHANT=zibal
# SITE_URL=https://moonshot.gold
# ZIBAL_CALLBACK_URL=https://moonshot.gold/payment/callback
# ZIBAL_REQUEST_URL=https://gateway.zibal.ir/v1/request
# ZIBAL_VERIFY_URL=https://gateway.zibal.ir/v1/verify
# ZIBAL_START_URL=https://gateway.zibal.ir/start

# Telegram manual verification (set on Convex deployment)
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_ADMIN_CHANNEL_ID=-1001234567890
# TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
# Register webhook: https://api.telegram.org/bot<token>/setWebhook?url=https://<deployment>.convex.site/telegram/webhook&secret_token=<secret>