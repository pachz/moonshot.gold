{
  "name": "moonshot-gold",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite",
    "dev:backend": "convex dev",
    "build": "tsc -p convex -noEmit --pretty false && tsc -p . -noEmit --pretty false && vite build",
    "build:frontend": "vite build",
    "codegen": "npx convex codegen --typecheck disable",
    "preview": "vite preview",
    "setup:auth": "node setupAuthKeys.mjs"
  },
  "dependencies": {
    "@auth/core": "^0.37.4",
    "@convex-dev/auth": "^0.0.80",
    "@convex-dev/rate-limiter": "^0.2.7",
    "convex": "^1.25.4",
    "convex-telegram": "^0.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.6.3",
    "sonner": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "npm-run-all": "^4.1.5",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
